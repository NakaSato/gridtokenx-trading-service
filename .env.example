# Trading Service — local dev environment template.
# Copy to .env (gitignored) and adjust:  cp .env.example .env
#
# Loaded by trading_core::config::Config::from_env() via dotenvy
# (crates/trading-core/src/config/mod.rs). Missing a REQUIRED var does not break
# `cargo check`/`build` — it fails at startup, and it fails `just verify-conns` /
# `./scripts/app.sh doctor` before any connection is probed.

# --- REQUIRED ---------------------------------------------------------------

# Trading owns its own database after the DB-per-service split; the shared
# `gridtokenx` DB no longer holds the trading schema. TRADING_DATABASE_URL is
# accepted as an alias.
DATABASE_URL=postgresql://gridtokenx_user:gridtokenx_password@localhost:7001/gridtokenx_trading

REDIS_URL=redis://localhost:7010

# Localnet validator: `just solana-up` / `./scripts/app.sh init` binds RPC 8899,
# so the pubsub (websocket) port is 8900.
SOLANA_RPC_URL=http://localhost:8899
SOLANA_WS_URL=ws://localhost:8900

# Program IDs and mint addresses below are localnet values written by
# `just sync-env` (from gridtokenx-anchor/Anchor.toml + the bootstrap output).
# Re-run it after `./scripts/app.sh init` rather than hand-editing.
ENERGY_TOKEN_MINT=GktSLt9dFsTrSSxikMEQRNeQXhpN9NxUn4m9teixctVS

# --- OPTIONAL ---------------------------------------------------------------

CURRENCY_TOKEN_MINT=7hg4h2BJPSLZsxUJn7BPKkGMjEVS2wVk5iW7X1E9Be1Z
SOLANA_TRADING_PROGRAM_ID=CnWDEUhTvSixeLSyViWgAnnu9YouBAYVGcrrFm1s9WcX

# Settlement fee/wheeling/loss destinations (dev wallet by default).
FEE_COLLECTOR_WALLET=EzudwoHvNPAc4dpPi5ndU8MEZVHVzq3Pj3Thm9ooKmiJ
WHEELING_COLLECTOR_WALLET=EzudwoHvNPAc4dpPi5ndU8MEZVHVzq3Pj3Thm9ooKmiJ
LOSS_COLLECTOR_WALLET=EzudwoHvNPAc4dpPi5ndU8MEZVHVzq3Pj3Thm9ooKmiJ

# All Solana writes go through Chain Bridge — never direct RPC from this service.
# CHAIN_BRIDGE_URL=http://127.0.0.1:5040
# CHAIN_BRIDGE_INSECURE=true          # dev only: skips mTLS

# Matching cadence. The CDA matcher is event-driven: an accepted realtime order
# wakes MatcherWorker, which matches after DEBOUNCE_MS (burst coalescing + cycle-
# rate floor). INTERVAL_MS is only a safety-net tick (e.g. orders inserted by
# another replica). Expiry needs no tick: reaping only removes liquidity, and the
# engine already skips expired orders. Set MATCHER_REALTIME=false for tick-only polling.
# MATCHER_REALTIME=true
# MATCHER_DEBOUNCE_MS=5
# MATCHER_INTERVAL_MS=1000

# Order lifetime. Clients may set an expiry per order (REST `expires_at` absolute
# or `expires_in_secs` relative, at most one); omitted → DEFAULT_TTL. MAX_TTL caps
# only client-supplied values and must be >= DEFAULT_TTL (startup fails otherwise).
# Bounded on purpose: the matcher re-reads the whole active book every cycle, so
# never-expiring orders make every cycle more expensive.
# DEFAULT_TTL is 15 min: one interval-clearing / settlement window, so an order
# that names no expiry does not outlive the window it was priced for.
# ORDER_DEFAULT_TTL_SECS=900
# ORDER_MAX_TTL_SECS=604800

# IAM_GRPC_URL=http://127.0.0.1:5010
# KAFKA_EVENTS_ENABLED=false          # true also needs KAFKA_BOOTSTRAP_SERVERS
# TRADING_ROLE=api                    # api | matcher
# HTTP_PORT=8093
# GRPC_PORT=8092

# Secrets: set locally, never commit real values.
# INTERNAL_API_KEY=
# ENCRYPTION_SECRET=                  # 32+ chars
